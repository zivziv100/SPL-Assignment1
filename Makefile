# משתנה - שומר את הקומפיילר
CXX = g++

# דגלי קמפול לפי סעיף 3.3
# -g : מוסיף מידע לדיבאג, עבור valgrind וgdb
# -Wall: מדליק את האזהרות
# -Weffc++: מדליק אזהרות לפי Effective C++, למשל אתחול שדות בInitializerList ומימוש Rule Of 5 במחלקות השומרות מצביעים
# -std=c+11: מקמפל לפי תקן C++11
# -Iinclude: אומר לקומפיילר לחפש קבצי Header בתיקייה /include
CXXFLAGS = -g -Wall -Weffc++ -std=c++11 -Iinclude

SRCS = $(wildcard src/*.cpp) # אוסף אוטומטית את כל קבצי ה.cpp שבתוך /src
OBJS = $(patsubst src/%.cpp,bin/%.o,$(SRCS)) # הופך כל קובץ cpp לקובץ o. כלומר, כך נקבל את רשימת כל קבצי ה-object שצריך לבנות

all: bin/server # הכלל הראשון - אומר שה"מטרה הראשית" היא לבנות את bin/server

bin/server : $(OBJS) # כדי לבנות את קובץ ההרצה, צריך את כל קבצי ה-o
	$(CXX) -o bin/server $(OBJS)
# שלב ה-linking:
# 	מחבר את כל קבצי .o לתוכנה אחת.
#	-o: קובע את שם הפלט

bin/%.o: src/%.cpp # כלל אחד לכל הקבצים, כל קובץ bin/%.o נבנה מקובץ src/%.cpp. % - מייצג את שם הקובץ.
	@mkdir -p bin 
# יוצר את bin אם היא לא קיימת. -p מונע שגיאה אם היא כבר קיימת. @ - מסתיר את הדפסת הפקודה
	$(CXX) $(CXXFLAGS) -c $< -o $@
# שלב הCompilation של קובץ אחד:
#	-c : רק מקמפל לקובץ .o. בלי לקשר
#	$< : התלות הראשונה. כלומר, קובץ .cpp
#	$@ : ה-target. כלומר, קובץ ה-.o 

clean: # מוחק את כל הקבצים המקומפלים מbin ומשאיר את התיקייה. -f : מונע שגיאה אם אין מה למחוק
	rm -f bin/*

.PHONY: all clean # מסמן שהשמות all וclean הם שמות של פעולות, ולא קבצים. ככה גם אם קיים קובץ בשם כזה, הם ירוצו בכל מקרה.